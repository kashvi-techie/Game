--- /dev/null
+++ b/game/input/esp32/WebSerialTransport.ts
@@ -0,0 +1,139 @@
+import type { LineTransport, TransportHandlers } from "./LineTransport";
+
+/* Minimal Web Serial typings: TypeScript's lib.dom does not ship them, and we avoid an extra dependency. */
+interface SerialPortLike {
+  readable: ReadableStream<Uint8Array> | null;
+  open(options: { baudRate: number }): Promise<void>;
+  close(): Promise<void>;
+}
+interface SerialLike {
+  requestPort(): Promise<SerialPortLike>;
+  addEventListener(type: "disconnect", listener: (event: Event) => void): void;
+  removeEventListener(type: "disconnect", listener: (event: Event) => void): void;
+}
+
+const BAUD_RATE = 115200;
+/** Safety valve: if the device never sends a newline, do not buffer forever. */
+const MAX_LINE_LENGTH = 1024;
+
+function getSerial(): SerialLike | null {
+  if (typeof navigator === "undefined") return null;
+  return (navigator as unknown as { serial?: SerialLike }).serial ?? null;
+}
+
+export function isWebSerialSupported() {
+  return getSerial() !== null;
+}
+
+export class WebSerialTransport implements LineTransport {
+  readonly kind = "serial" as const;
+
+  private port: SerialPortLike | null = null;
+  private reader: ReadableStreamDefaultReader<string> | null = null;
+  private pipeDone: Promise<void> | null = null;
+  private userClosing = false;
+
+  constructor(private readonly handlers: TransportHandlers) {}
+
+  private readonly onPortDisconnect = (event: Event) => {
+    // Fired by the browser when the USB device is physically unplugged.
+    if (event.target === this.port) void this.teardown("ESP32 unplugged");
+  };
+
+  /** Must be called from a user gesture (button click): requestPort() shows the browser's port chooser. */
+  async connect() {
+    const serial = getSerial();
+    if (!serial) {
+      this.handlers.onStatus("disconnected", "Web Serial is not supported in this browser (use Chrome or Edge).");
+      return;
+    }
+
+    this.handlers.onStatus("connecting");
+    this.userClosing = false;
+
+    try {
+      const port = await serial.requestPort();
+      await port.open({ baudRate: BAUD_RATE });
+      if (!port.readable) throw new Error("Serial port is not readable");
+
+      this.port = port;
+      serial.addEventListener("disconnect", this.onPortDisconnect);
+
+      // bytes -> text. pipeTo() lets us cancel cleanly later.
+      const decoder = new TextDecoderStream();
+      this.pipeDone = port.readable.pipeTo(decoder.writable as unknown as WritableStream<Uint8Array>).catch(() => {});
+      this.reader = decoder.readable.getReader();
+
+      this.handlers.onStatus("connected");
+      void this.readLoop(this.reader);
+    } catch (error) {
+      await this.teardown(describeConnectError(error));
+    }
+  }
+
+  async disconnect() {
+    this.userClosing = true;
+    await this.teardown();
+  }
+
+  private async readLoop(reader: ReadableStreamDefaultReader<string>) {
+    let buffer = "";
+    let failure: string | undefined;
+
+    try {
+      for (;;) {
+        const { value, done } = await reader.read();
+        if (done) break;
+        buffer += value;
+
+        let newline = buffer.indexOf("\n");
+        while (newline !== -1) {
+          const line = buffer.slice(0, newline).replace(/\r$/, "");
+          buffer = buffer.slice(newline + 1);
+          if (line) this.handlers.onLine(line);
+          newline = buffer.indexOf("\n");
+        }
+        if (buffer.length > MAX_LINE_LENGTH) buffer = "";
+      }
+    } catch (error) {
+      failure = error instanceof Error ? error.message : "Serial read error";
+    }
+
+    // Loop ended on its own (device lost / read error) rather than via disconnect().
+    if (!this.userClosing && this.port) await this.teardown(failure ?? "Serial connection closed");
+  }
+
+  private async teardown(detail?: string) {
+    const port = this.port;
+    const reader = this.reader;
+    this.port = null;
+    this.reader = null;
+    getSerial()?.removeEventListener("disconnect", this.onPortDisconnect);
+
+    try {
+      await reader?.cancel();
+    } catch {
+      /* already closed */
+    }
+    await this.pipeDone;
+    this.pipeDone = null;
+    try {
+      await port?.close();
+    } catch {
+      /* already closed / unplugged */
+    }
+
+    this.handlers.onStatus("disconnected", detail);
+  }
+}
+
+function describeConnectError(error: unknown): string | undefined {
+  if (error instanceof DOMException) {
+    // User dismissed the port chooser: not an error worth showing.
+    if (error.name === "NotFoundError") return undefined;
+    if (error.name === "InvalidStateError" || error.name === "NetworkError") {
+      return "Could not open the port. Is it already in use (Arduino IDE / serial monitor)?";
+    }
+  }
+  return error instanceof Error ? error.message : "Could not connect to ESP32";
+}
diff --git a/game/input/esp32/esp32Protocol.ts b/game/input/esp32/esp32Protocol.ts
new file mode 100644
index 0000000..2e2ceb5
--- /dev/null
+++ b/game/input/esp32/esp32Protocol.ts
@@ -0,0 +1,82 @@
+import { type ControllerControls, neutralControls } from "../ControllerInputSource";
+
+/**
+ * Wire format (one JSON object per line, newline-terminated):
+ *   {"x":2048,"y":2048,"button":false}
+ * x / y : raw 12-bit ADC values, 0..4095, ~2048 at rest
+ * button: boolean (0/1 also accepted); optional, defaults to false
+ */
+export type JoystickSample = { x: number; y: number; button: boolean };
+
+export type JoystickCalibration = {
+  /** ADC value at rest. */
+  center: number;
+  /** Highest ADC value (ESP32 is 12-bit by default). */
+  adcMax: number;
+  /** Fraction of full deflection (0..1) ignored around the center. */
+  deadZone: number;
+  /** Flip left/right if the stick is mounted the other way round. */
+  invertX: boolean;
+  /**
+   * Y axis maps to throttle/brake. By default a LOW raw y (stick pushed "up"/forward) is throttle
+   * and a HIGH raw y is brake. Flip if your module is wired the other way.
+   */
+  invertY: boolean;
+};
+
+export const DEFAULT_JOYSTICK_CALIBRATION: JoystickCalibration = {
+  center: 2048,
+  adcMax: 4095,
+  deadZone: 0.12,
+  invertX: false,
+  invertY: false,
+};
+
+/** Returns null for anything that is not a valid sample (boot logs, partial lines, junk). */
+export function parseControllerLine(line: string): JoystickSample | null {
+  const trimmed = line.trim();
+  // ESP32 prints boot/debug text on the same UART; ignore anything that is not a JSON object.
+  if (trimmed.length === 0 || trimmed[0] !== "{") return null;
+
+  let data: unknown;
+  try {
+    data = JSON.parse(trimmed);
+  } catch {
+    return null;
+  }
+  if (typeof data !== "object" || data === null) return null;
+
+  const { x, y, button } = data as Record<string, unknown>;
+  if (typeof x !== "number" || typeof y !== "number") return null;
+  if (!Number.isFinite(x) || !Number.isFinite(y)) return null;
+
+  return { x, y, button: button === true || button === 1 };
+}
+
+/** raw ADC -> -1..+1 with dead zone. The dead zone is rescaled so output ramps smoothly from 0 at its edge. */
+export function normalizeAxis(raw: number, calibration: JoystickCalibration): number {
+  const { center, adcMax, deadZone } = calibration;
+  const span = raw >= center ? adcMax - center : center;
+  const linear = Math.max(-1, Math.min(1, (raw - center) / span));
+  const magnitude = Math.abs(linear);
+  if (magnitude <= deadZone) return 0;
+  return Math.sign(linear) * ((magnitude - deadZone) / (1 - deadZone));
+}
+
+/** JoystickSample -> the same InputState the keyboard produces. */
+export function joystickToInputState(
+  sample: JoystickSample,
+  calibration: JoystickCalibration = DEFAULT_JOYSTICK_CALIBRATION,
+): ControllerControls {
+  const steering = normalizeAxis(sample.x, calibration) * (calibration.invertX ? -1 : 1);
+  // Raw y grows downward (like screen coordinates): negative = pushed forward = throttle.
+  const forward = -normalizeAxis(sample.y, calibration) * (calibration.invertY ? -1 : 1);
+
+  return {
+    ...neutralControls,
+    steering,
+    throttle: Math.max(0, forward),
+    brake: Math.max(0, -forward),
+    action1: sample.button,
+  };
+}
